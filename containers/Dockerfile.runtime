# syntax=docker/dockerfile:1
# --- Builder stage: installs deps with gcc available ---
FROM python:3.11-slim AS builder

# uv cache lives at /root/.cache/uv; the BuildKit mount below persists it
# across rebuilds. No need to set PIP_NO_CACHE_DIR — we don't use pip.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# uv: 10–100× faster than pip, honors pyproject.toml [tool.uv.sources] pins,
# matches the project-wide tooling (see memory: prefer uv over pip).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99no-sandbox \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml /app/pyproject.toml
COPY containers/requirements-worker.txt /app/requirements-worker.txt

# Pre-install CPU-only torch + torchvision from the pytorch.org CPU index
# (these are pulled in transitively by docling for its layout/table models).
# Without this, the default PyPI index gives the CUDA-enabled wheels, which
# ship ~2.7 GB of nvidia/* runtime libs + ~640 MB triton that never run in
# this container (no GPU code here — embed/rerank are remote via TEI).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --prefix=/install \
        --index-url https://download.pytorch.org/whl/cpu \
        torch torchvision

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --prefix=/install -r /app/requirements-worker.txt \
    && find /install -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /install -type d -name tests -prune -exec rm -rf {} + \
    && find /install -type d -name test -prune -exec rm -rf {} + \
    && find /install -name "*.pyc" -delete \
    && find /install -name "*.pyo" -delete

# --- Runtime stage: no build tools ---
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

# Runtime apt deps: ca-certificates for TLS, plus the shared libraries Docling's
# PDF/Office parsing pulls in transitively (OpenCV/Qt -> libGL, glib, libxcb, X11).
# Without these, Docling conversion fails at import with "libxcb.so.1: cannot open
# shared object file" and all PDF/docx/pptx ingestion errors out.
RUN echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99no-sandbox \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgl1 \
    libglib2.0-0 \
    libxcb1 \
    libxrender1 \
    libxext6 \
    libsm6 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder (no build tools come along)
COPY --from=builder /install /usr/local

# Run as root — in rootless Podman, container root maps to the host user,
# so this is safe. (chown to a non-root uid requires setuid newuidmap/newgidmap.)
COPY config /app/config
COPY src /app/src
COPY server /app/server
COPY prompts /app/prompts
